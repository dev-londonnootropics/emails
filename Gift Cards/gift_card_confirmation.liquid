Here's your gift card that was sent to {{ recipient_name }}. {% endif %} {%
endcapture %} {% endif %}

<!DOCTYPE html>
<html lang="en">
  <head>
    <title>{{ email_title }}</title>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
    <meta name="viewport" content="width=device-width">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Baskervville&family=Prompt&display=swap" rel="stylesheet" />
    <link rel="stylesheet" type="text/css" href="/assets/notifications/styles.css">
      <style data-shopify="">
    
  @font-face {
    font-family: "ABC Gramercy";
    src: url(//londonnootropics.com/cdn/shop/t/65/assets/ABCGramercy-Book.woff?v=64752516815934044661731407032) format("woff"),
    url(//londonnootropics.com/cdn/shop/t/65/assets/ABCGramercy-Book.woff2?v=120962658477511410001731407034) format("woff2");
    font-weight: 400;
    font-style: normal;
    font-display: swap;
  }

    p,
    del,
    td {
    font-family: "ABC Gramercy";
    color: #3A3A3A !important;
    font-weight: 400 !important;
}
    
  @font-face {
    font-family: "Soehne Breit";
    src: url(//londonnootropics.com/cdn/shop/t/65/assets/soehne-breit-dreiviertelfett.woff2?v=34998399807108532631731407035) format("woff2");
    font-weight: 700;
    font-style: normal;
    font-display: swap;
  }

  @font-face {
    font-family: "Soehne Breit";
    src: url(//londonnootropics.com/cdn/shop/t/65/assets/soehne-breit-halbfett.woff2?v=123037843758697194421731407034) format("woff2");
    font-weight: 600;
    font-style: normal;
    font-display: swap;
  }

    h1,
    h2,
    h3,
    h4,
    strong,
    span {
  font-family: "Soehne Breit";
  color: #3A3A3A;
    }

  :root {
    --font-gramercy: "ABC Gramercy", "Lucida Sans", "Lucida Sans Unicode", Geneva, Verdana, sans-serif;
    --font-soehne: "Soehne Breit", 'Century Gothic', CenturyGothic, AppleGothic, sans-serif;

    --font-heading-family: var(--font-gramercy);

    --font-body-scale: 1;
    --font-heading-scale: 1;

    --color-background-body: #fffdf8;
    --color-background-media: #e5e5e5;

    --color-headings: #000;
    --color-paragraphs: #000;

    --color-solid-button: #1d1d1d;
    --color-solid-button-background: #c699c3;

    --color-solid-button-alt: #c699c3;
    --color-solid-button-background-alt: #1d1d1d;

    --color-outline-button: #c699c3;
    --color-outline-button-hover: #fff;
    --color-outline-button-border: #c699c3;

    --color-red: #ff2424;
    --color-background-primary: #000;
    --color-background-secondary: #fff;
    --color-background-accent: #e5e5e5;
    --color-subdued: #6e6151;
    --color-border: #c6c6c6;--page-width: 1440px;

    --spacing-grid-col: 3.2rem;
    --spacing-grid-row: 7.2rem;
    --spacing-grid-col-mobile: 2.4rem;
    --spacing-grid-row-mobile: 3.8rem;

    --duration-short: 100ms;
    --duration-default: 300ms;
    --duration-long: 500ms;

    --z-header: 400;
    --z-modals: 800;
  }</style>
  </head>

  <body>
    <table align="center" class="body giftcard__body">
      <tr>
        <td class="empty-line">&nbsp;</td>
      </tr>
      <tr>
        <td class="empty-line">&nbsp;</td>
      </tr>
      <tr>
        <td>
          <table class="row content">
            <tr>
              <td class="content__cell">
                <center>
                  <table class="container">
                    <tr>
                      <td>
                        {% if gift_card.recipient %}
                        {% if shop.email_logo_url %}
                        <table align="center" class="giftcard__doubletopmargin">
                          <tr>
                            <td>
                              <img src="{{shop.email_logo_url}}" alt="{{ shop.name }}" class="giftcard__logosize" width="{{ shop.email_logo_width }}">
                            </td>
                          </tr>
                        </table>
                        {% endif %}

                        <table align="center" class="row giftcard__topmargin">
                          <tr>
                            <td class="giftcard__title">{{ email_title }}</td>
                          </tr>
                        </table>

                        {% if gift_card.recipient and gift_card.message != blank %}
                        <table align="center" class="row giftcard__topmargin">
                          <tr>
                            <td class="giftcard__message">
                              "{{ gift_card.message }}"
                            </td>
                          </tr>
                        </table>
                        {% endif %}

                        <table align="center" class="giftcard__topmargin">
                          <tr>
                            <td class="giftcard__balance">{{ gift_card.initial_value | money_with_currency }}</td>
                          </tr>
                          {% if gift_card.expires_on %}
                          <tr>
                            <td class="giftcard__smalltext">
                              Expires {{ gift_card.expires_on | date: '%B %e, %Y' }}
                            </td>
                          </tr>
                          {% endif %}
                        </table>

                        <table align="center" class="giftcard__doubletopmargin">
                          <tr>
                            <td>
                              <img src="{{ 'mushroomlove.webp' | file_url }}" alt="Gift card image" width="240" height="240">
                            </td>
                          </tr>
                        </table>



                        <table align="center" class="row giftcard__topmargin">
                          <tr>
                            <td style="font-size: 18px; padding-top: 20px" class="giftcard__smalltext">
                              Use the gift card code online
                            </td>
                          </tr>
                          <tr>
                            <td style="padding-top: 20px" class="giftcard__code">
                              <strong>{{ gift_card.code | format_code }}</strong>
                            </td>
                          </tr>
                        </table>

                        <table class="row actions">
                          <tr>
                            <td class="actions__cell">
                              <table align="center" class="button">
                                <tr>
                                  <td style="border-radius: 0px !important;" bgcolor="#C699C3" class="button__cell"><a style="font-family: 'Soehne Breit', sans-serif; border-radius: 0px !important; color: #000; padding: 12px 30px; font-size: 14px" href="{{ shop.url }}" class="button__text">VISIT ONLINE STORE</a></td>
                                </tr>
                              </table>
                              <table align="center" class="button">
                                <tr>
                                  <td class="link__cell">
                                     <a style="font-size: 18px; font-weight: bold" href="{{ gift_card.url }}" class="link__text">View gift card balance</a>
                                  </td>
                                </tr>
                              </table>
                            </td>
                          </tr>
                        </table>

                        {% if gift_card.pass_url %}
                        <table align="center" class="row">
                          <tr>
                            <td class="giftcard__textcenter">
                              <a href="{{ gift_card.pass_url }}" class="apple-wallet-button">
                                <img src="{{ 'gift-card/add-to-apple-wallet.png' | shopify_asset_url }}" alt="Add to Apple Wallet" width="120" height="40">
                              </a>
                            </td>
                          </tr>
                        </table>
                        {% endif %}

                        {% else %}
                        {% if shop.email_logo_url %}
                        <table align="center" class="giftcard__doubletopmargin">
                          <tr>
                            <td>
                              <img src="{{shop.email_logo_url}}" alt="{{ shop.name }}" class="giftcard__logosize" width="{{ shop.email_logo_width }}">
                            </td>
                          </tr>
                        </table>
                        {% endif %}

                        {% if gift_card.recipient and gift_card.message != blank %}
                        <table align="center" class="row giftcard__topmargin">
                          <tr>
                            <td class="giftcard__message">
                              "{{ gift_card.message }}"
                            </td>
                          </tr>
                        </table>
                        {% endif %}

                        <table align="center" class="giftcard__topmargin">
                          <tr>
                            <td class="giftcard__balance">{{ gift_card.initial_value | money_with_currency }}</td>
                          </tr>
                          {% if gift_card.expires_on %}
                          <tr>
                            <td class="giftcard__smalltext">
                              Expires {{ gift_card.expires_on | date: '%B %e, %Y' }}
                            </td>
                          </tr>
                          {% endif %}
                        </table>

                        <table align="center" class="giftcard__doubletopmargin">
                          <tr>
                            <td>
                              <img src="{{ 'mushroomlove.webp' | file_url }}" alt="Gift card image" width="240" height="240">
                            </td>
                          </tr>
                        </table>

                        <table align="center" class="row giftcard__topmargin">
                          <tr>
                            <td style="font-size: 18px; padding-top: 20px" class="giftcard__smalltext">
                              Use the gift card code online
                            </td>
                          </tr>
                          <tr>
                            <td style="padding-top: 20px" class="giftcard__code">
                              <strong>{{ gift_card.code | format_code }}</strong>
                            </td>
                          </tr>
                        </table>

                        <table class="row actions">
                          <tr>
                            <td class="actions__cell">
                              <table align="center" class="button">
                                <tr>
                                  <td style="border-radius: 0px !important;" bgcolor="#C699C3" class="button__cell"><a style="font-family: 'Soehne Breit', sans-serif; border-radius: 0px !important; color: #000; padding: 12px 30px; font-size: 14px" href="{{ shop.url }}" class="button__text">VISIT ONLINE STORE</a></td>
                                </tr>
                              </table>

                              <table align="center" class="button">
                                <tr>
                                  <td class="link__cell">
                                    <a style="font-size: 18px; font-weight: bold" href="{{ gift_card.url }}" class="link__text">View gift card balance</a>
                                  </td>
                                </tr>
                              </table>
                            </td>
                          </tr>
                        </table>

                        {% if gift_card.pass_url %}
                        <table align="center" class="row">
                          <tr>
                            <td class="giftcard__textcenter">
                              <a href="{{ gift_card.pass_url }}" class="apple-wallet-button">
                                <img src="{{ 'gift-card/add-to-apple-wallet.png' | shopify_asset_url }}" alt="Add to Apple Wallet" width="120" height="40">
                              </a>
                            </td>
                          </tr>
                        </table>
                        {% endif %}

                        {% endif %}
                      </td>
                    </tr>
                  </table>
                </center>
              </td>
            </tr>
          </table>
          <table class="row footer">
  <tr>
    <td class="footer__cell">
      <center>
        <table class="container">
          <tr>
            <td>
              <h3 style="margin-bottom: 10px">Elevate your day.</h3>
              <p style="text-align: left" class="disclaimer__subtext">If you have any questions, reply to this email or contact us at <a style="color: #c699c3" href="mailto:{{ shop.email }}">{{ shop.email }}</a></p>
            </td>
          </tr>
        </table>
      </center>
    </td>
  </tr>
</table>

          
        </td>
      </tr>
    </table>
  </body>
</html>
