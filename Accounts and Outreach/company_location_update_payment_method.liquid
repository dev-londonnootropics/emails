{% capture email_title %}Update your payment method{% endcapture %}
{% capture email_greeting %}Hi {{display_name}},{% endcapture %}
{% capture email_body %}
  Hope you're well!
<br><br>
We’re getting in touch as it looks like you recently requested to update your payment method, or we weren’t able to process your latest payment.
<br><br>
To ensure your adaptogenic coffee arrives smoothly, you can update your payment details below, or check in with your bank to confirm everything is correct. 
<br><br>
We’re here if you need anything or have any questions 🍄💜 
{% endcapture %}

<!DOCTYPE html>
<html lang="en">
  <head>
  <title>{{ email_title }}</title>
  <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
  <meta name="viewport" content="width=device-width">
  <link rel="stylesheet" type="text/css" href="/assets/notifications/styles.css">
  <style data-shopify="">
    
  @font-face {
    font-family: "ABC Gramercy";
    src: url(//londonnootropics.com/cdn/shop/t/65/assets/ABCGramercy-Book.woff?v=64752516815934044661731407032) format("woff"),
    url(//londonnootropics.com/cdn/shop/t/65/assets/ABCGramercy-Book.woff2?v=120962658477511410001731407034) format("woff2");
    font-weight: 400;
    font-style: normal;
    font-display: swap;
  }

    p,
    del,
    td {
    font-family: "ABC Gramercy";
    color: #3A3A3A !important;
    font-weight: 400 !important;
}
    
  @font-face {
    font-family: "Soehne Breit";
    src: url(//londonnootropics.com/cdn/shop/t/65/assets/soehne-breit-dreiviertelfett.woff2?v=34998399807108532631731407035) format("woff2");
    font-weight: 700;
    font-style: normal;
    font-display: swap;
  }

  @font-face {
    font-family: "Soehne Breit";
    src: url(//londonnootropics.com/cdn/shop/t/65/assets/soehne-breit-halbfett.woff2?v=123037843758697194421731407034) format("woff2");
    font-weight: 600;
    font-style: normal;
    font-display: swap;
  }

    h1,
    h2,
    h3,
    h4,
    strong,
    span {
  font-family: "Soehne Breit";
  color: #3A3A3A;
    }

  :root {
    --font-gramercy: "ABC Gramercy", "Lucida Sans", "Lucida Sans Unicode", Geneva, Verdana, sans-serif;
    --font-soehne: "Soehne Breit", 'Century Gothic', CenturyGothic, AppleGothic, sans-serif;

    --font-heading-family: var(--font-gramercy);

    --font-body-scale: 1;
    --font-heading-scale: 1;

    --color-background-body: #fffdf8;
    --color-background-media: #e5e5e5;

    --color-headings: #000;
    --color-paragraphs: #000;

    --color-solid-button: #1d1d1d;
    --color-solid-button-background: #c699c3;

    --color-solid-button-alt: #c699c3;
    --color-solid-button-background-alt: #1d1d1d;

    --color-outline-button: #c699c3;
    --color-outline-button-hover: #fff;
    --color-outline-button-border: #c699c3;

    --color-red: #ff2424;
    --color-background-primary: #000;
    --color-background-secondary: #fff;
    --color-background-accent: #e5e5e5;
    --color-subdued: #6e6151;
    --color-border: #c6c6c6;--page-width: 1440px;

    --spacing-grid-col: 3.2rem;
    --spacing-grid-row: 7.2rem;
    --spacing-grid-col-mobile: 2.4rem;
    --spacing-grid-row-mobile: 3.8rem;

    --duration-short: 100ms;
    --duration-default: 300ms;
    --duration-long: 500ms;

    --z-header: 400;
    --z-modals: 800;
  }</style>
</head>

  <body>
    <table class="body">
      <tr>
        <td>
          <table class="header row">
  <tr>
    <td class="header__cell">
      <center>

        <table class="container">
          <tr>
            <td>

              <table class="row">
                <tr>
                  <td class="shop-name__cell">
                    {%- if shop.email_logo_url %}
                      <img src="{{shop.email_logo_url}}" alt="{{ shop.name }}" width="{{ shop.email_logo_width }}">
                    {%- else %}
                      <h1 class="shop-name__text">
                        <a href="{{shop.url}}">{{ shop.name }}</a>
                      </h1>
                    {%- endif %}
                  </td>

                </tr>
              </table>

            </td>
          </tr>
        </table>

      </center>
    </td>
  </tr>
</table>

          <table class="row content">
  <tr>
    <td class="content__cell">
      <center>
        <table class="container">
          <tr>
            <td>
              
            <h2 style="margin-bottom: 20px">{{ email_title }}</h2>
            <p>{{ email_greeting }}</p>
            <p style="margin-bottom: 20px">{{ email_body }}</p>
            <table class="row actions">
              <tr>
                <td class="empty-line">&nbsp;</td>
              </tr>
              <tr>
                <td class="actions__cell">
                  <table class="button main-action-cell">
                    <tr>
                      <td style="border-radius: 0px !important;" bgcolor="#C699C3" class="button__cell"><a style="font-family: 'Soehne Breit', sans-serif; border-radius: 0px !important; color: #000; padding: 12px 30px; font-size: 14px" href="{{ email_confirmation_url }}" class="button__text">VIEW PAYMENT INFORMATION</a></td>
                    </tr>
                  </table>
                  {% if shop.url %}
    <table class="link secondary-action-cell">
      <tr>
        <td class="link__cell">or <a style="color: #c699c3" href="{{ shop.url }}">Visit our store</a></td>
      </tr>
    </table>
{% endif %}
                </td>
              </tr>
            </table>

            </td>
          </tr>
        </table>
      </center>
    </td>
  </tr>
</table>
          <table class="row footer">
  <tr>
    <td class="footer__cell">
      <center>
        <table class="container">
          <tr>
            <td>
              <h3 style="margin-bottom: 10px">Elevate your day.</h3>
              <p style="text-align: left" class="disclaimer__subtext">If you have any questions, reply to this email or contact us at <a style="color: #c699c3" href="mailto:{{ shop.email }}">{{ shop.email }}</a></p>
            </td>
          </tr>
        </table>
      </center>
    </td>
  </tr>
</table>

<img src="{{ 'notifications/spacer.png' | shopify_asset_url }}" class="spacer" height="1" />

        </td>
      </tr>
    </table>
  </body>
</html>
