{% if gift_card.recipient %} {% if gift_card.recipient.nickname != blank %} {%
assign recipient_name = gift_card.recipient.nickname %} {% elsif
gift_card.recipient.name != blank %} {% assign recipient_name =
gift_card.recipient.name %} {% else %} {% assign recipient_name =
gift_card.recipient.email %} {% endif %} {% capture email_title %} {% if
gift_card.send_on != blank %} Here's your gift card that will be sent to {{
